{
  "name": "r2_e4_combined",
  "description": "Combination of A and B on top of r2_e2_v3. Only adopted if A and B are each non-inferior on their own (docs/METHODOLOGY.md section 6).",
  "model_name": "google-bert/bert-base-multilingual-cased",
  "label_policy": "v3",
  "augment": "format_A",
  "augment_fraction": 0.5,
  "learning_rate": 2e-05,
  "epochs": 2,
  "batch_size": 16,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "seed": 42,
  "diagnostic_sets": [
    "dev_v1"
  ],
  "extra_train": [
    "data/synth/round2/A_train.jsonl",
    "data/synth/round2/B_train.jsonl"
  ]
}
